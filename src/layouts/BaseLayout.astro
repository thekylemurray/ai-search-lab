---
import DocumentLayout from "./DocumentLayout.astro";

const {
  title = "AI Search Lab | Kyle Murray",
  description = "A working portfolio exploring AI discoverability, content architecture, and modern web operations.",
} = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<DocumentLayout title={title} description={description}>
    <header class="site-header">
      <nav class="site-nav">
        <a href="/" class={currentPath === "/" ? "active" : ""}>
          Home
        </a>

        <a href="/experiments" class={currentPath.startsWith("/experiments") ? "active" : ""}>
          Experiments
        </a>

        <a href="/topics" class={currentPath.startsWith("/topics") ? "active" : ""}>
          Topics
        </a>

        <a href="/projects" class={currentPath.startsWith("/projects") ? "active" : ""}>
          Projects
        </a>

        <a href="/web-ops" class={currentPath.startsWith("/web-ops") ? "active" : ""}>
  Web Ops
</a>

        <a href="/ev-lab" class={currentPath.startsWith("/ev-lab") ? "active" : ""}>
          EV Landing Lab
        </a>

        <a href="/about" class={currentPath.startsWith("/about") ? "active" : ""}>
          About
        </a>

        <a href="/contact" class={currentPath.startsWith("/contact") ? "active" : ""}>
          Contact
        </a>
      </nav>
    </header>

   <div class="page-shell">
  <slot />
</div>

    <footer class="site-footer">
      <p>© 2026 Kyle Murray</p>
      <p>Built with Astro • Exploring AI discoverability</p>
    </footer>
</DocumentLayout>
