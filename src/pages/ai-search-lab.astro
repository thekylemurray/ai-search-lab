---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="AI Search Lab | Kyle Murray"
  description="A working portfolio exploring AI discoverability, content architecture, and modern web operations."
>
  <main class="home">
    <section class="hero">
      <p class="eyebrow">AI Search Lab</p>

      <h1>
        Experiments in AI discoverability, content architecture, and modern web operations.
      </h1>

      <p class="lede">
        A working portfolio exploring how websites can become easier for people,
        search engines, and AI systems to understand.
      </p>

      <div class="hero-actions">
        <a class="button" href="/experiments">
          View experiments
        </a>

        <a class="button secondary" href="/ev-lab">
          View EV Landing Lab
        </a>
      </div>
    </section>

    <section class="cards">
      <article class="card">
        <h2>AI discoverability</h2>
        <p>
          Experiments around structured content, retrieval, AI search visibility,
          and how modern websites can be interpreted by generative systems.
        </p>
      </article>

      <article class="card">
        <h2>Content systems</h2>
        <p>
          Notes and builds around CMS architecture, content modeling, governance,
          metadata, and scalable publishing workflows.
        </p>
      </article>

      <article class="card">
        <h2>Web operations</h2>
        <p>
          Practical work across Astro, Sanity, deployment, QA, SEO, analytics,
          lead capture, and technical marketing execution.
        </p>
      </article>
    </section>
  </main>
</BaseLayout>