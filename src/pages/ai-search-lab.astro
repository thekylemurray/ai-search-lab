---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="AI Search Lab | Kyle Murray"
  description="A working portfolio exploring AI discoverability, content architecture, and modern web operations."
>
  <main class="home">
    <section class="hero">
      <p class="eyebrow">AI Search Lab</p>

      <h1>
        Experiments in AI discoverability, content architecture, and modern web operations.
      </h1>

      <p class="lede">
        A working portfolio exploring how websites can become easier for people,
        search engines, and AI systems to understand.
      </p>
    </section>

    <section class="cards">
      <a class="card" href="/experiments/ai-understand">
        <p class="eyebrow">Experiment</p>
        <h2>AI discoverability</h2>
        <p>
          Experiments around structured content, retrieval, AI search visibility,
          and how modern websites can be interpreted by generative systems.
        </p>
      </a>

      <a class="card" href="/experiments/seo-vs-ai">
        <p class="eyebrow">Experiment</p>
        <h2>SEO vs AI</h2>
        <p>
          Exploring where traditional SEO ends and AI discoverability begins.
        </p>
      </a>

      <a class="card" href="/experiments/javascript-rendered-content">
        <p class="eyebrow">Experiment</p>
        <h2>JavaScript-rendered content</h2>
        <p>
          Testing whether delivery architecture affects how AI systems retrieve,
          understand, and cite content.
        </p>
      </a>
    </section>
  </main>
</BaseLayout>