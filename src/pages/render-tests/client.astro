---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { renderTestContent } from "../../data/renderTestContent";
---

<BaseLayout
  title="Client Render Test"
  description="A client-rendered JavaScript test page for evaluating AI retrieval reliability."
>

<h1>{renderTestContent.title}</h1>

<p class="lede">
Rendering method: Client-rendered JavaScript
</p>

<div id="client-content">
  <p>
    Loading client-rendered test content...
  </p>
</div>

<script>
  import { renderTestContent as content } from "../../data/renderTestContent";

  const container = document.querySelector("#client-content");

  if (container) {
    container.innerHTML = `
      <h2>Main Recommendation</h2>

      <p>${content.recommendation}</p>

      <h2>Experiment Context</h2>

      <p>${content.body}</p>
    `;
  }
</script>

</BaseLayout>