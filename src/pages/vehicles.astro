---
import {sanityClient} from '../lib/sanity'

const vehicles = await sanityClient.fetch(`
  *[_type=="vehicle"]{
    title,
    heroText,
    price,
    "slug": slug.current
  }
`)
---

<h1>EV Landing Lab</h1>

{
  vehicles.map((vehicle:any)=>(
    <div>
      <h2>{vehicle.title}</h2>
      <p>{vehicle.heroText}</p>
      <p>{vehicle.price}</p>
      <p>Slug: {vehicle.slug}</p>
    </div>
  ))
}